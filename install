#!/usr/bin/env bash
set -e
set -o pipefail

export REPO="jmalloc/dotfiles"
export BRANCH="nix"

sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

dir=$(mktemp -d -t dotfiles)
trap 'rm -rf -- "$dir"' EXIT
cd $dir

curl https://github.com/${REPO}/archive/refs/heads/${BRANCH}.zip --output dotfiles.zip
unzip dotfiles.zip

for f in "install.d/"*-*; do
  source "$f"
done
