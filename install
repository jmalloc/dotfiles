#!/usr/bin/env bash
set -e
set -o pipefail

export REPO="jmalloc/dotfiles"
export BRANCH="nix"

sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

mkdir -p /tmp/dotfiles
cd /tmp/dotfiles

if [ -d .git ]; then
    git pull
else
    git clone \
        --single-branch --branch "${BRANCH}"  \
        "git@github.com:${REPO}.git" .
fi


# if [ ! -d /nix ]; then
#     curl -sSf -L https://install.lix.systems/lix \
#         | sh -s -- install --enable-flakes --no-confirm
# fi

# echo continuing ...
