#!/usr/bin/env bash
set -e
set -o pipefail

export REPO="jmalloc/dotfiles"
export BRANCH="nix"

sudo -v
while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

dir=$(mktemp -d -t dotfiles)
trap 'rm -rf -- "$dir"' EXIT
cd "$dir"

curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --output dotfiles.zip \
    https://github.com/${REPO}/archive/refs/heads/${BRANCH}.zip

unzip -q dotfiles.zip
cd "dotfiles-${BRANCH}"

for f in "install.d/"*-*; do
    echo "--- $f"
    source "$f"
done
